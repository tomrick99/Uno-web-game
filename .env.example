SPRING_PROFILES_ACTIVE=prod
PORT=8080

MYSQL_URL=jdbc:mysql://localhost:3306/uno_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=utf8
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# Optional if your platform provides split MySQL variables instead of MYSQL_URL
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=uno_db
MYSQLUSER=your_mysql_user
MYSQLPASSWORD=your_mysql_password

# Optional comma-separated origin patterns
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://*.railway.app,https://*.up.railway.app,https://*.onrender.com
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://*.railway.app,https://*.up.railway.app,https://*.onrender.com
